{
  "schema_version": 1,
  "updated_at": "2026-11-20T00:00:00Z",
  "rules": [
    {
      "id": "E_OOM",
      "match": "(out of memory|OutOfMemoryError|DefaultCPUAllocator: can't allocate memory)",
      "severity": "error",
      "title": "显存不够",
      "explain": "显卡的显存放不下这次要算的东西。生成时把尺寸改小一点；训练时把「显存」选小一档。",
      "solutions": [{ "label": "查看日志", "action": "open_job_log" }],
      "dedupe": { "windowSec": 60, "maxPerWindow": 1 }
    },
    {
      "id": "E_MODULE",
      "match": "ModuleNotFoundError: No module named '([^']+)'",
      "severity": "error",
      "title": "训练环境缺少组件：{1}",
      "explain": "训练环境没有装完整，通常是安装中途断了。到「设置 › 训练」重新安装训练环境再试。",
      "solutions": [
        { "label": "重新安装训练环境", "action": "open_settings", "params": { "tab": "training" } },
        { "label": "查看日志", "action": "open_job_log" }
      ],
      "dedupe": { "windowSec": 120, "maxPerWindow": 1 }
    },
    {
      "id": "E_VERSION",
      "match": "(ImportError: cannot import name|version mismatch|requires .* but you have|Incompatible .* version)",
      "severity": "error",
      "title": "训练环境的组件版本不对",
      "explain": "训练环境里的组件和训练器不匹配，常见于更新训练器之后。到「设置 › 训练」重新安装训练环境再试。",
      "solutions": [
        { "label": "重新安装训练环境", "action": "open_settings", "params": { "tab": "training" } },
        { "label": "查看日志", "action": "open_job_log" }
      ],
      "dedupe": { "windowSec": 120, "maxPerWindow": 1 }
    },
    {
      "id": "E_NET",
      "match": "(HTTPError|SSLError|ConnectionError|Max retries exceeded|Read timed out|Failed to establish a new connection|Could not resolve host)",
      "severity": "warning",
      "title": "网络请求失败",
      "explain": "下载没有完成：网络连不上，或者这条下载线路用不了。换一条下载线路再试。",
      "solutions": [{ "label": "换下载线路", "action": "switch_mirror" }],
      "dedupe": { "windowSec": 60, "maxPerWindow": 1 }
    },
    {
      "id": "E_DISK",
      "match": "(No space left on device|ENOSPC|OSError: \\[Errno 28\\])",
      "severity": "error",
      "title": "磁盘空间不够",
      "explain": "保存模型或图片时磁盘满了。清理一些文件，或者换一个空间大的位置。",
      "solutions": [{ "label": "更换保存位置", "action": "open_settings", "params": { "tab": "storage" } }],
      "dedupe": { "windowSec": 300, "maxPerWindow": 1 }
    },
    {
      "id": "E_PORT",
      "match": "(Address already in use|OSError: \\[Errno 48\\]|WinError 10048)",
      "severity": "warning",
      "title": "端口被占用",
      "explain": "另一个程序（可能是上次没有退出的引擎）占着端口。退出它，或者重启电脑后再试。",
      "solutions": [{ "label": "查看日志", "action": "open_job_log" }],
      "dedupe": { "windowSec": 60, "maxPerWindow": 1 }
    },
    {
      "id": "E_AUTH",
      "match": "(401 Client Error|403 Client Error|gated repo|Access to model .* is restricted|Invalid username or password)",
      "severity": "warning",
      "title": "需要 Hugging Face 授权",
      "explain": "这个模型要先登录 Hugging Face 并同意许可。填好访问令牌后再下载。",
      "solutions": [{ "label": "填写访问令牌", "action": "open_settings", "params": { "tab": "network" } }],
      "dedupe": { "windowSec": 300, "maxPerWindow": 1 }
    },
    {
      "id": "E_KILLED",
      "match": "(Killed|exit code 137|signal 9|SIGKILL)",
      "severity": "error",
      "title": "被系统结束了",
      "explain": "通常是电脑内存不够，系统把它结束了。关掉其他占内存的程序再试；生成时也可以把尺寸改小一点。",
      "solutions": [{ "label": "查看日志", "action": "open_job_log" }],
      "dedupe": { "windowSec": 120, "maxPerWindow": 1 }
    },
    {
      "id": "E_EXIT",
      "match": null,
      "severity": "error",
      "title": "程序异常退出",
      "explain": "运行到一半退出了，没有认出原因。日志的最后几行通常会说明。",
      "solutions": [
        { "label": "查看日志", "action": "open_job_log" },
        { "label": "复制诊断信息", "action": "copy_diagnostics" }
      ],
      "dedupe": { "windowSec": 60, "maxPerWindow": 1 }
    }
  ]
}
